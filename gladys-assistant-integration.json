      "key": "camera_1",
      "type": "section",
      "label": {
        "en": "Camera 1",
        "fr": "Caméra 1",
        "de": "Kamera 1",
        "es": "Cámara 1"
      },
      "description": {
        "en": "A JPEG snapshot URL (http://user:password@camera/snapshot.jpg). Leave the address empty to skip a camera.",
        "fr": "Une URL d'instantané JPEG (http://utilisateur:motdepasse@camera/snapshot.jpg). Laissez l'adresse vide pour ne pas utiliser une caméra.",
        "de": "Eine JPEG-Schnappschuss-URL (http://benutzer:passwort@kamera/snapshot.jpg). Lass die Adresse leer, um eine Kamera auszulassen.",
        "es": "Una URL de instantánea JPEG (http://usuario:contraseña@camara/snapshot.jpg). Deje la dirección vacía para no usar una cámara."
      }
    },
