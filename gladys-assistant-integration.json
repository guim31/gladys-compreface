{
  "manifest_version": 1,
  "type": "device",
  "name": "CompreFace",
  "description": {
    "en": "Local face recognition on your camera images with CompreFace: who is at the door, without the cloud.",
    "fr": "Reconnaissance faciale locale sur vos caméras avec CompreFace : qui est à la porte, sans cloud.",
    "de": "Lokale Gesichtserkennung in deinen Kamerabildern mit CompreFace: Wer ist an der Tür, ohne Cloud.",
    "es": "Reconocimiento facial local en sus cámaras con CompreFace: quién está en la puerta, sin nube."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-compreface:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-compreface/main/cover.png",
  "categories": ["security"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your CompreFace server",
        "fr": "Votre serveur CompreFace",
        "de": "Dein CompreFace-Server",
        "es": "Su servidor CompreFace"
      },
      "description": {
        "en": "CompreFace recognizes the faces of the people you taught it, on your own machine. Enter its address and the key of a Recognition service, then up to four cameras below, and open the Discovery tab.",
        "fr": "CompreFace reconnaît les visages des personnes que vous lui avez apprises, sur votre propre machine. Saisissez son adresse et la clé d'un service Recognition, puis jusqu'à quatre caméras ci-dessous, et ouvrez l'onglet Découverte.",
        "de": "CompreFace erkennt die Gesichter der Personen, die du ihm beigebracht hast, auf deinem eigenen Rechner. Gib seine Adresse und den Schlüssel eines Recognition-Dienstes ein, dann unten bis zu vier Kameras, und öffne den Tab „Entdecken“.",
        "es": "CompreFace reconoce los rostros de las personas que usted le ha enseñado, en su propia máquina. Introduzca su dirección y la clave de un servicio Recognition, luego hasta cuatro cámaras más abajo, y abra la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-compreface/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "CompreFace address",
        "fr": "Adresse de CompreFace",
        "de": "CompreFace-Adresse",
        "es": "Dirección de CompreFace"
      },
      "description": {
        "en": "Without a port, 8000 is used. Add https:// for a reverse proxy.",
        "fr": "Sans port, 8000 est utilisé. Ajoutez https:// derrière un proxy inverse.",
        "de": "Ohne Port wird 8000 verwendet. Füge https:// hinter einem Reverse-Proxy hinzu.",
        "es": "Sin puerto, se usa el 8000. Añada https:// detrás de un proxy inverso."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.20",
        "fr": "ex. 192.168.1.20",
        "de": "z. B. 192.168.1.20",
        "es": "p. ej. 192.168.1.20"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "API key of the Recognition service",
        "fr": "Clé d'API du service Recognition",
        "de": "API-Schlüssel des Recognition-Dienstes",
        "es": "Clave de API del servicio Recognition"
      },
      "description": {
        "en": "In CompreFace: your application, a service of type Recognition, its API key.",
        "fr": "Dans CompreFace : votre application, un service de type Recognition, sa clé d'API.",
        "de": "In CompreFace: deine Anwendung, ein Dienst vom Typ Recognition, sein API-Schlüssel.",
        "es": "En CompreFace: su aplicación, un servicio de tipo Recognition, su clave de API."
      },
      "required": true
    },
    {
      "key": "similarity",
      "type": "select",
      "label": {
        "en": "Minimum similarity",
        "fr": "Similarité minimale",
        "de": "Mindestähnlichkeit",
        "es": "Similitud mínima"
      },
      "description": {
        "en": "Below it, a face is an unknown one. Higher: fewer mistakes, more unknown faces.",
        "fr": "En dessous, un visage est inconnu. Plus haut : moins d'erreurs, plus de visages inconnus.",
        "de": "Darunter gilt ein Gesicht als unbekannt. Höher: weniger Verwechslungen, mehr unbekannte Gesichter.",
        "es": "Por debajo, un rostro es desconocido. Más alta: menos errores, más rostros desconocidos."
      },
      "required": false,
      "default": "85",
      "options": [
        {
          "value": "70",
          "label": {
            "en": "70 %",
            "fr": "70 %",
            "de": "70 %",
            "es": "70 %"
          }
        },
        {
          "value": "75",
          "label": {
            "en": "75 %",
            "fr": "75 %",
            "de": "75 %",
            "es": "75 %"
          }
        },
        {
          "value": "80",
          "label": {
            "en": "80 %",
            "fr": "80 %",
            "de": "80 %",
            "es": "80 %"
          }
        },
        {
          "value": "85",
          "label": {
            "en": "85 %",
            "fr": "85 %",
            "de": "85 %",
            "es": "85 %"
          }
        },
        {
          "value": "90",
          "label": {
            "en": "90 %",
            "fr": "90 %",
            "de": "90 %",
            "es": "90 %"
          }
        },
        {
          "value": "95",
          "label": {
            "en": "95 %",
            "fr": "95 %",
            "de": "95 %",
            "es": "95 %"
          }
        }
      ]
    },
    {
      "key": "detection",
      "type": "select",
      "label": {
        "en": "Face detection threshold",
        "fr": "Seuil de détection des visages",
        "de": "Schwelle der Gesichtserkennung",
        "es": "Umbral de detección de rostros"
      },
      "description": {
        "en": "How sure CompreFace must be that a shape is a face. Lower finds small or turned faces, and more false faces.",
        "fr": "À quel point CompreFace doit être sûr qu'une forme est un visage. Plus bas trouve les visages petits ou de profil, et plus de faux visages.",
        "de": "Wie sicher CompreFace sein muss, dass eine Form ein Gesicht ist. Niedriger findet kleine oder gedrehte Gesichter und mehr falsche.",
        "es": "Hasta qué punto CompreFace debe estar seguro de que una forma es un rostro. Más bajo encuentra rostros pequeños o de perfil, y más rostros falsos."
      },
      "required": false,
      "default": "80",
      "options": [
        {
          "value": "50",
          "label": {
            "en": "50 %",
            "fr": "50 %",
            "de": "50 %",
            "es": "50 %"
          }
        },
        {
          "value": "70",
          "label": {
            "en": "70 %",
            "fr": "70 %",
            "de": "70 %",
            "es": "70 %"
          }
        },
        {
          "value": "80",
          "label": {
            "en": "80 %",
            "fr": "80 %",
            "de": "80 %",
            "es": "80 %"
          }
        },
        {
          "value": "90",
          "label": {
            "en": "90 %",
            "fr": "90 %",
            "de": "90 %",
            "es": "90 %"
          }
        }
      ]
    },
    {
      "key": "interval",
      "type": "select",
      "label": {
        "en": "Analysis interval",
        "fr": "Intervalle d'analyse",
        "de": "Analyseintervall",
        "es": "Intervalo de análisis"
      },
      "description": {
        "en": "Each added camera is analyzed this often, one after the other. Every analysis takes CPU on the CompreFace machine.",
        "fr": "Chaque caméra ajoutée est analysée à ce rythme, l'une après l'autre. Chaque analyse consomme du processeur sur la machine de CompreFace.",
        "de": "Jede hinzugefügte Kamera wird in diesem Takt analysiert, eine nach der anderen. Jede Analyse kostet CPU auf dem CompreFace-Rechner.",
        "es": "Cada cámara añadida se analiza con esta frecuencia, una tras otra. Cada análisis consume CPU en la máquina de CompreFace."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "0",
          "label": {
            "en": "On demand only",
            "fr": "À la demande seulement",
            "de": "Nur auf Anfrage",
            "es": "Solo bajo demanda"
          }
        },
        {
          "value": "5",
          "label": {
            "en": "5 seconds",
            "fr": "5 secondes",
            "de": "5 Sekunden",
            "es": "5 segundos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 seconds",
            "fr": "10 secondes",
            "de": "10 Sekunden",
            "es": "10 segundos"
          }
        },
        {
          "value": "30",
