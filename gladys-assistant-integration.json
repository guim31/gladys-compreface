      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Feature names and scene texts.",
        "fr": "Noms des fonctionnalités et textes des scènes.",
