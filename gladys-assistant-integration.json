  "actions": [
    {
      "key": "check",
      "label": {
        "en": "Check the connection",
        "fr": "Vérifier la connexion",
        "de": "Verbindung prüfen",
        "es": "Comprobar la conexión"
      },
      "description": {
        "en": "Lists the people CompreFace knows, then analyzes each camera once.",
        "fr": "Liste les personnes que CompreFace connaît, puis analyse chaque caméra une fois.",
        "de": "Listet die Personen auf, die CompreFace kennt, und analysiert dann jede Kamera einmal.",
        "es": "Enumera las personas que CompreFace conoce y analiza cada cámara una vez."
      },
      "timeout_seconds": 120
    },
    {
      "key": "add_face",
      "label": {
        "en": "Add a face",
        "fr": "Ajouter un visage",
        "de": "Gesicht hinzufügen",
        "es": "Añadir un rostro"
      },
      "description": {
        "en": "Stand alone in front of a camera: the face it sees now becomes an example of this person.",
        "fr": "Placez-vous seul(e) devant une caméra : le visage qu'elle voit devient un exemple de cette personne.",
        "de": "Stell dich allein vor eine Kamera: Das Gesicht, das sie jetzt sieht, wird ein Beispiel dieser Person.",
        "es": "Colóquese solo(a) frente a una cámara: el rostro que ve ahora se convierte en un ejemplo de esta persona."
      },
      "timeout_seconds": 90,
      "fields": [
        {
          "key": "camera",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Camera",
            "fr": "Caméra",
            "de": "Kamera",
            "es": "Cámara"
          },
          "required": true
        },
        {
          "key": "person",
          "type": "string",
          "label": {
            "en": "Name of the person",
            "fr": "Nom de la personne",
            "de": "Name der Person",
            "es": "Nombre de la persona"
          },
          "required": true
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "person_recognized",
      "label": {
        "en": "Person recognized by CompreFace",
        "fr": "Personne reconnue par CompreFace",
        "de": "Person von CompreFace erkannt",
        "es": "Persona reconocida por CompreFace"
      },
      "description": {
        "en": "A known person appears in a regular analysis (absent from the previous one).",
        "fr": "Une personne connue apparaît lors d'une analyse régulière (absente de la précédente).",
